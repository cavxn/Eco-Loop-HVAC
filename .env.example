# Copy to .env and fill in values
ENERGYPLUS_ROOT=/Users/cavins/EnergyPlus/EnergyPlus-25.2.0-cf7368216c-Darwin-macOS13-arm64

# Groq (default) — https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Or Together.ai / Llama 3.3 70B when quota allows:
# LLM_MODEL=llama-3.3-70b-versatile

AGENT_CALLBACK_INTERVAL=12
COMFORT_TEMP_MIN_C=21.0
COMFORT_TEMP_MAX_C=25.0
LLM_MAX_RETRIES=2

# Optional live carbon API (expects JSON with carbon_intensity in kg/kWh or g/kWh)
# CARBON_API_URL=
